# --- Veritabani (Neon / Vercel Postgres) ---
# Vercel > Storage > Neon baglaninca ikisi de otomatik gelir.
# Lokal icin: console.neon.tech > Connection string (pooled + direct).
DATABASE_URL="postgresql://...?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://...?sslmode=require"

# --- Odeme ---
# "test": teklif aninda gecerli sayilir, para istenmez (gelistirme)
# "live": Iyzico Checkout Form devreye girer
PAYMENT_MODE="test"

# Iyzico uye isyeri anahtarlari (tuzel kisilik + basvuru onayi sart)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://api.iyzipay.com"
