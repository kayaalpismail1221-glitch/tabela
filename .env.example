# Prisma Postgres tek baglanti dizesi veriyor (db.prisma.io).
# Vercel > Storage > Prisma Postgres baglayinca bu isim otomatik olusuyor.
DATABASE_URL="postgres://KULLANICI:ANAHTAR@db.prisma.io:5432/postgres?sslmode=require"

# Odeme canliya alininca "live" yap (tuzel kisilik + Iyzico uye isyeri gerekir)
PAYMENT_MODE="test"

IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --- Bildirim ("uste cikildin" maili) ---
# Ikisi birden dolu degilse gonderim SESSIZCE atlanir; teklif yine gecerli
# olur, sebep Outbid.error alanina yazilir.
RESEND_API_KEY=""
MAIL_FROM="Tabela <bildirim@tabela.lol>"

# Mail icindeki baglantilar mutlak olmak zorunda. Normalde BOS BIRAK:
# production'da kanonik alan adi (https://tabela.lol) koddan geliyor
# (src/lib/site.ts). Yalnizca gecici/ozel bir adres gerekiyorsa doldur.
SITE_URL=""
