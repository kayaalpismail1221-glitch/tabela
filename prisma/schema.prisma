// Tabela — tek ekonomi, iki gorunum.
// Genel liste = tum ilanlar teklife gore.
// Sehir listesi = ayni listenin sehir suzulmus hali.
//
// Postgres (Neon/Vercel). Enum kullanilmadi, String alanlar bilerek secildi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma Postgres tek bir baglanti dizesi veriyor; Neon'daki gibi ayri bir
  // havuzsuz adres yok, bu yuzden directUrl tanimli degil. Neon/Supabase gibi
  // havuzlu-havuzsuz ayrimi olan bir saglayiciya gecilirse buraya
  // directUrl = env("DATABASE_URL_UNPOOLED") satiri geri eklenir.
}

model Listing {
  id   String @id @default(cuid())
  name String

  // Tek baglanti: Instagram profili VEYA kendi sitesi. Tur adresten cikariliyor
  // (src/lib/links.ts). Ayni adres iki kez tahtaya cikamaz.
  url String @unique

  city        String // il slug: "istanbul"
  district    String? // ilce, opsiyonel
  imageUrl    String?
  description String

  // Ilan sahibi. Iki isi birden goruyor:
  //   1) Iyzico alici bilgisi (uydurma veri fraud skorlamasini bozuyor)
  //   2) "Uste cikildin" bildirimi — tekrar gelirin motoru
  // Ilan formunda sorulmuyor; odeme adiminda toplanacak (Iyzico alici bilgisi
  // + "uste cikildin" bildirimi icin gerekli).
  ownerName  String?
  ownerEmail String?
  ownerPhone String?

  // Sira = currentBid DESC, firstBidAt ASC (esitlikte eski teklif ustte)
  currentBid Int       @default(0) // kurus
  firstBidAt DateTime?
  /** Son gecerli teklifin zamani — listede "14 dk once" olarak gorunuyor. */
  lastBidAt  DateTime?

  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  bids       Bid[]
  clicks     Click[]
  deliveries Delivery[]

  @@index([currentBid])
  @@index([city, currentBid])
}

model Bid {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amount Int // teklifin ulastigi toplam tutar (kurus)
  paid   Int // bu islemde tahsil edilen fark (kendi ilanini yukseltirken sadece fark)

  status String @default("PENDING") // PENDING | PAID | FAILED | EXPIRED

  // Iyzico Checkout Form: token bize doner, callback ile ayni kaydi buluruz
  paymentToken String? @unique
  paymentRef   String? // Iyzico paymentId (tahsilat gerceklestikten sonra)
  failureCode  String?
  failureMsg   String?

  // Aktivite akisi icin: bu teklif kimi geride birakti (gorunen ad)
  passedLabel String?
  rankAfter    Int? // teklif gecerli oldugunda olusan genel sira

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([listingId])
}

model Click {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorKey String
  ts         DateTime @default(now())

  @@index([listingId, ts])
}

// Tahtasi olmayan sehir icin bekleme listesi.
// N talep gelince o sehir anasayfada acilir.
model CityRequest {
  id        String   @id @default(cuid())
  city      String
  handle    String
  email     String
  createdAt DateTime @default(now())

  @@unique([city, handle])
}

// Haftalik teslimat kaniti (story/post). Satisin tamami buna dayaniyor.
model Delivery {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  week         String // "2026-W34"
  scope        String // NATIONAL | CITY
  deliveredUrl String?
  createdAt    DateTime @default(now())

  @@unique([week, scope, listingId])
}

// Ziyaretci sayaci. Cerez YOK, ham IP saklanmiyor: anahtar IP+tarayici
// bilgisinden turetilen geri dondurulemez bir ozet. Gizlilik metninde
// tiklama sayaci icin anlatilan yontemin aynisi.
model Visitor {
  key       String   @id
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}
